# Secrets for the Groww Weekly Review Pulse.
# Copy this file to .env (git-ignored) and fill in the values. Never commit .env.
# On GitHub Actions or Codespaces, add the same names as repository secrets instead.

# Groq free-tier API key, from https://console.groq.com/keys (starts with "gsk_").
GROQ_API_KEY=

# Bearer token for the hosted MCP server in config/mcp.yaml (server.auth_token_env). Copy it from the
# server's Render dashboard (Environment → MCP_AUTH_TOKEN). Sent only as an Authorization header.
MCP_AUTH_TOKEN=

# Only for the alternative local workspace-mcp server (stdio), passed to it by name from config/mcp.yaml.
# OAuth client from Google Cloud Console (Desktop app; Docs, Drive and Gmail APIs enabled).
# Our code never reads these values; only the MCP server process uses them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The Google account the server acts for (Doc owner, draft sender).
USER_GOOGLE_EMAIL=
